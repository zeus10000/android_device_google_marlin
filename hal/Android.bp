// Display HAL prebuilt libraries from LOS22

cc_prebuilt_library_shared {
    name: "gralloc.msm8996",
    vendor: true,
    relative_install_path: "hw",
    check_elf_files: false,
    prefer: true,
    strip: { none: true },
    target: {
        android_arm64: { srcs: ["gralloc.msm8996_64.so"] },
        android_arm: { srcs: ["gralloc.msm8996_32.so"] },
    },
    compile_multilib: "both",
}

