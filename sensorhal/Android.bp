cc_library_static {
    name: "libnanohub_sensorlist",
    vendor: true,
    cflags: select(soong_config_variable("nanohub_sensorhal", "direct_report_enabled"), {
        "true": [ "-DDIRECT_REPORT_ENABLED" ],
        default: [],
    }),
    srcs: [
        "sensorlist.cpp",
    ],
    include_dirs: [
        "device/google/contexthub/sensorhal"
    ],
    header_libs: ["libhardware_headers"],
}

cc_prebuilt_library_shared {
    name: "sensors.nanohub",
    vendor: true,
    relative_install_path: "hw",
    check_elf_files: false,
    prefer: true,
    strip: { none: true },
    target: {
        android_arm64: { srcs: ["sensors.nanohub_64.so"] },
        android_arm: { srcs: ["sensors.nanohub_32.so"] },
    },
    compile_multilib: "both",
}
