# init_foreground domain for init.foreground.sh
type init_foreground, domain;
type init_foreground_exec, exec_type, vendor_file_type, file_type;
domain_auto_trans(init, init_foreground_exec, init_foreground)

# cpuset access
allow init_foreground device:dir { write add_name };
allow init_foreground device:file { create write open };
allow init_foreground self:capability dac_override;

# toybox execution
allow init_foreground vendor_toolbox_exec:file { execute execute_no_trans read open getattr };

# pgrep needs to scan /proc
r_dir_file(init_foreground, domain)
allow init_foreground domain:dir getattr;

# Allow init_foreground to setsched on kernel threads
allow init_foreground kernel:process setsched;
