# Marlin-specific additions for /vendor/bin/pm-service
# Core rules come from device/qcom/sepolicy-legacy-um/legacy/vendor/common/peripheral_manager.te

# Allow reading msm subsystem sysfs nodes for modem state detection
r_dir_file(vendor_per_mgr, sysfs_msm_subsys)

# Read boot_status_prop to know when modem firmware loading is complete
get_prop(vendor_per_mgr, boot_status_prop)

# Read vendor config files for per-peripheral tunables
allow vendor_per_mgr vendor_file:dir read;

# Legacy Qualcomm pm-service/pm-proxy binaries talk to the regular
# servicemanager (not vndservicemanager) for service registration.
# This predates the Android vndbinder isolation and cannot be fixed
# without source access to the proprietary binary.
binder_call(vendor_per_mgr, servicemanager)
allow vendor_per_mgr default_android_service:service_manager { add find };
