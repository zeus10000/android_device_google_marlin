# Policy for /vendor/bin/pm-proxy (marlin-specific supplementary domain)
#
# Note: upstream Qualcomm file_contexts labels /vendor/bin/pm-proxy as
# vendor_per_mgr_exec, so by default pm-proxy runs in the vendor_per_mgr
# domain alongside pm-service. This domain definition is kept as a
# supplementary option in case marlin wants to isolate pm-proxy in its
# own domain via a future file_contexts override.
type vendor_per_proxy, domain;
type vendor_per_proxy_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_per_proxy)

r_dir_file(vendor_per_proxy, sysfs_type)

use_vendor_per_mgr(vendor_per_proxy)
