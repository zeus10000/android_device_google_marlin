cc_binary {
    name: "android.hardware.vibrator-service.marlin",
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.marlin.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.marlin.xml"],
    vendor: true,
    srcs: [
        "service.cpp",
        "Vibrator.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "android.hardware.vibrator-V3-ndk",
    ],
}
